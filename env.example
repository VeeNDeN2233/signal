# Скопируйте в .env или выполните из корня: node scripts/bootstrap-env.js
# (скрипт создаст .env со случайными JWT.)

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=signal_db

# Секреты JWT — смените на случайные длинные строки (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Порты на хосте
API_PORT=3000
WEB_PORT=8080
