# Локальный API при `cd backend && npm run …` — копируйте в `backend/.env`.
# Docker и общий шаблон для корня: ../env.example → корневой `.env`.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=signal_db

# Секреты JWT — смените на случайные длинные строки (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Порт процесса Node (в Docker проброс хоста задаётся API_PORT в корневом .env)
PORT=3000
