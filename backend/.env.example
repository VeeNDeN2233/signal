# Параметры подключения к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signal_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Параметры сервера
PORT=3000

# JWT секреты
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
